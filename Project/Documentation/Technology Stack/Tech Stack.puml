@startuml
title Project Management Plan - Technology Stack

package "Frontend" {
  [HTML]
  [CSS]
  [JavaScript]
  [Bootstrap]
}

package "Backend" {
  [PHP]
}

database "MariaDB" as mariadb

package "Version Control" {
  [Git]
  [GitHub]
}

package "Communication" {
  [Discord]
}

actor "Users" as user

user --> [HTML]
user --> [CSS]
user --> [JavaScript]

[HTML] --> [Bootstrap]
[JavaScript] --> [Bootstrap]

[Frontend] --> [PHP]

[PHP] --> mariadb

[Git] --> [GitHub]
[Team Members] --> [Git]
[Team Members] --> [Discord]

@enduml
